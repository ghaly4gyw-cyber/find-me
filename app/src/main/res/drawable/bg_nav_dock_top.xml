<?xml version="1.0" encoding="utf-8"?>
<!-- The header + quick-tools row now sits on one shared "dock" surface
     instead of the plain page background, with a soft rounded bottom edge —
     visually tying the title bar and the tool icons together as a single
     unit (per the "make the navbar and buttons feel less separated" ask)
     rather than two independent rows floating on the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nav_surface" />
    <corners
        android:bottomLeftRadius="20dp"
        android:bottomRightRadius="20dp" />
</shape>
