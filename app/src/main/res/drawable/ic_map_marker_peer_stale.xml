<?xml version="1.0" encoding="utf-8"?>
<!-- A teammate whose last known position is no longer fresh — grayed out,
     same idea as the radar view's stale-peer dot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#40AFC9C7" />
            <size android:width="30dp" android:height="30dp" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#AFC9C7" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
