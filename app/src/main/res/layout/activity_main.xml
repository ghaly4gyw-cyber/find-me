<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sand_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/amber_500"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- maxLines/ellipsize: a log finally caught this row's own
                 height ballooning to nearly the full screen at random,
                 swallowing every other view below it - this TextView's text
                 (device/mesh status, which can vary) is the most likely
                 thing to have wrapped into dozens of lines when that
                 happened. Capping it to one line makes that structurally
                 impossible from here on, whatever exactly triggered it. -->
            <TextView
                android:id="@+id/meshStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mesh_status_off"
                android:textColor="@color/sand_300"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lives here instead of floating over the map so it's visible on
             every tab, not just while the map happens to be open — and so
             the radar view itself isn't partly covered by a pill sitting on
             top of it. -->
        <TextView
            android:id="@+id/daylightHeaderPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/sand_900"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="☼ 5h 15m" />

        <TextView
            android:id="@+id/toolsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="🛠️"
            android:textSize="18sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_tab_item_selected"
            android:maxLines="1" />

        <TextView
            android:id="@+id/buddyCheckinButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="🤝"
            android:textSize="18sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_tab_item_selected"
            android:maxLines="1" />

        <TextView
            android:id="@+id/languageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="🌐"
            android:textSize="18sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_tab_item_selected"
            android:maxLines="1" />

        <TextView
            android:id="@+id/myNameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/teal_400"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_tab_item_selected"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Miner-3F2A ✎" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/night_panel"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_needed"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/grantPermissionsButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permissions" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locationServicesBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/night_panel"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location_services_needed"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/enableLocationButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/enable_location" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/batteryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/night_panel"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_optimization_needed"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/allowBatteryButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/allow_battery" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/night_panel"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/tabPeers"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:text="@string/tab_peers" />

            <Button
                android:id="@+id/tabMap"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:text="@string/tab_map" />

            <Button
                android:id="@+id/tabChat"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:text="@string/tab_chat" />

            <Button
                android:id="@+id/tabSos"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sos_red"
                android:textSize="11sp"
                android:text="@string/tab_sos" />

            <Button
                android:id="@+id/tabPosts"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:text="@string/tab_posts" />

            <Button
                android:id="@+id/tabGroups"
                style="@style/FindMe.Button.Tab"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:text="@string/tab_groups" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
