<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sand_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/amber_500"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meshStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mesh_status_off"
                android:textColor="@color/sand_300"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/myNameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sand_300"
            android:textSize="13sp"
            android:padding="8dp"
            android:background="@color/sand_700"
            tools:text="Miner-3F2A ✎"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sand_700"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_needed"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/grantPermissionsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_permissions" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/sand_700"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/tabPeers"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/amber_500"
            android:textSize="11sp"
            android:text="@string/tab_peers" />

        <Button
            android:id="@+id/tabChat"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sand_300"
            android:textSize="11sp"
            android:text="@string/tab_chat" />

        <Button
            android:id="@+id/tabSos"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sos_red"
            android:textSize="11sp"
            android:text="@string/tab_sos" />

        <Button
            android:id="@+id/tabPosts"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sand_300"
            android:textSize="11sp"
            android:text="@string/tab_posts" />

        <Button
            android:id="@+id/tabGroups"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sand_300"
            android:textSize="11sp"
            android:text="@string/tab_groups" />
    </LinearLayout>

</LinearLayout>
