<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sand_900">

    <!-- Title bar only — kept to one slim row on every screen. Everything
         that used to always sit below it (the tool-icon row and the
         permission/location/battery banners) now lives in the collapsible
         toolsPanel below, opened with menuToggleButton — "does not have
         anything... make it so it opens when someone clicks it". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_nav_dock_top"
        android:elevation="4dp"
        android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/amber_500"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- maxLines/ellipsize: a log finally caught this row's own
                 height ballooning to nearly the full screen at random,
                 swallowing every other view below it - this TextView's text
                 (device/mesh status, which can vary) is the most likely
                 thing to have wrapped into dozens of lines when that
                 happened. Capping it to one line makes that structurally
                 impossible from here on, whatever exactly triggered it. -->
            <TextView
                android:id="@+id/meshStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mesh_status_off"
                android:textColor="@color/sand_300"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lives here instead of floating over the map so it's visible on
             every tab, not just while the map happens to be open — and so
             the radar view itself isn't partly covered by a pill sitting on
             top of it. -->
        <TextView
            android:id="@+id/daylightHeaderPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="☼ 5h 15m" />

        <!-- Opens/closes toolsPanel below. The small red dot overlaps its
             corner only when a permission/location/battery banner actually
             needs attention, so the icon stays meaningful even collapsed. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/menuToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:padding="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/open_tools_menu" />

            <View
                android:id="@+id/menuAlertDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dot_alert"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- Collapsed by default so every tab — the map most of all — gets the
         full screen; opened with menuToggleButton above. Every quick-access
         tool plus the three status banners live here now instead of always
         sitting between the title bar and the content, "eating space that
         does not have anything" when there's nothing to act on. -->
    <LinearLayout
        android:id="@+id/toolsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_nav_dock_top"
        android:elevation="4dp"
        android:visibility="gone">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layoutAnimation="@anim/layout_fade_up">

            <TextView
                android:id="@+id/notesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📝"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/tools_notes"
                android:maxLines="1" />

            <TextView
                android:id="@+id/calculatorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🧮"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/tools_calculator"
                android:maxLines="1" />

            <TextView
                android:id="@+id/accountsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="💰"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/tools_accounts"
                android:maxLines="1" />

            <TextView
                android:id="@+id/onlineContactsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📡"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/online_contacts_title"
                android:maxLines="1" />

            <TextView
                android:id="@+id/pendingActivationsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🛡️"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/activation_pending_title"
                android:visibility="gone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/feedbackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="💡"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:contentDescription="@string/tools_suggest_feature"
                android:maxLines="1" />

            <TextView
                android:id="@+id/buddyCheckinButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🤝"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:maxLines="1" />

            <TextView
                android:id="@+id/languageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🌐"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:maxLines="1" />

            <TextView
                android:id="@+id/toolsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item"
                android:maxLines="1" />

            <TextView
                android:id="@+id/myNameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/teal_400"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tab_item_selected"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Miner-3F2A ✎" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- These three were each a full padded paragraph-plus-button block,
         which on the map tab in particular (the one screen that most needs
         its vertical space) could add up to nearly half the screen before
         a single permission was even granted — "make this a full screen...
         make it more big". Compacted to one slim row each: a warning icon,
         the explanation capped to 2 lines instead of wrapping freely, and
         a small inline button at the end instead of a full-width one below
         it. Still exactly as readable, just no longer fighting the map for
         space. -->
    <LinearLayout
        android:id="@+id/permissionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/night_panel"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/permissions_needed"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/grantPermissionsButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textSize="12sp"
            android:text="@string/grant_permissions" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locationServicesBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/night_panel"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/location_services_needed"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/enableLocationButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textSize="12sp"
            android:text="@string/enable_location" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/batteryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/night_panel"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/battery_optimization_needed"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/allowBatteryButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textSize="12sp"
            android:text="@string/allow_battery" />
    </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom tab row, on the matching bg_nav_dock_bottom surface (rounded
         top edge, elevated) — the other half of the unified top/bottom nav
         dock described above. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_dock_bottom"
        android:elevation="8dp"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layoutAnimation="@anim/layout_fade_up">

            <Button
                android:id="@+id/tabPeers"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_peers" />

            <Button
                android:id="@+id/tabMap"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_map" />

            <Button
                android:id="@+id/tabChat"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_chat" />

            <Button
                android:id="@+id/tabSos"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sos_red"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_sos" />

            <Button
                android:id="@+id/tabPosts"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_posts" />

            <Button
                android:id="@+id/tabGroups"
                style="@style/FindMe.Button.Tab"
                android:layout_width="wrap_content"
                android:minWidth="68dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="@color/sand_300"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:text="@string/tab_groups" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
