<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/activationGateExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activation_gate_explanation"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/activationCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/activation_code_hint"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/sand_300" />

        <Button
            android:id="@+id/activationCodeSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/activation_code_submit" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="@string/activation_or"
            android:textColor="@color/sand_300"
            android:textSize="12sp" />

        <Button
            android:id="@+id/activationRequestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="?android:attr/borderlessButtonStyle"
            android:text="@string/activation_request_button"
            android:textColor="@color/teal_400" />

        <TextView
            android:id="@+id/activationRequestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/sand_300"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/activationAdminContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/sand_300"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
