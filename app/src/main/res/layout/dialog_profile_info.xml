<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/profileInfoPhoto"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/sand_700"
        android:scaleType="centerCrop"
        android:contentDescription="@string/profile_photo" />

    <TextView
        android:id="@+id/profileInfoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/profileInfoPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/profileInfoDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/profileInfoLockedNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/profile_info_locked_note"
        android:textColor="@color/sand_300"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/profileInfoPinStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/sand_300"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/profileInfoPinButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:padding="6dp"
        android:text="@string/profile_set_pin_button"
        android:textColor="@color/teal_400" />

    <TextView
        android:id="@+id/profileInfoThemeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:padding="6dp"
        android:textColor="@color/teal_400"
        tools:text="🌓 Theme: Follow system" />

</LinearLayout>
