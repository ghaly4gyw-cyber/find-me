<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/viewProfilePhoto"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@color/sand_700"
        android:scaleType="centerCrop"
        android:contentDescription="@string/profile_photo" />

    <TextView
        android:id="@+id/viewProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        tools:text="Miner-3F2A"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/viewProfileDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sand_300"
        android:textSize="13sp"
        tools:text="340 m away • last seen 1 min ago"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/viewProfileDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/white"
        tools:text="Experienced prospector, know the eastern ridge well."
        xmlns:tools="http://schemas.android.com/tools" />

    <LinearLayout
        android:id="@+id/viewProfilePhoneRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/callButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/call" />

        <Button
            android:id="@+id/whatsappButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/whatsapp" />
    </LinearLayout>

    <TextView
        android:id="@+id/viewProfileNoPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/sand_300"
        android:textSize="12sp"
        android:text="@string/no_phone_shared" />

</LinearLayout>
