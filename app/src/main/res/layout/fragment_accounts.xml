<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/sand_700">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/accountsTotalTheyOwe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/teal_400"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="لك: 150 محلي" />

            <TextView
                android:id="@+id/accountsTotalIOwe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sos_red"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="عليك: 20 محلي" />
        </LinearLayout>

        <TextView
            android:id="@+id/addAccountButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/account_add_button" />
    </LinearLayout>

    <EditText
        android:id="@+id/accountsSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/sand_900"
        android:hint="@string/account_search_hint"
        android:textColor="@color/white"
        android:textColorHint="@color/sand_300"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        android:id="@+id/accountsEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/accounts_empty"
        android:textColor="@color/sand_300"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/accountsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
