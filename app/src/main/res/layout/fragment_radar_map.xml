<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ghaly.findme.ui.RadarMapView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Real map mode (OpenStreetMap tiles), toggled on by mapToggleButton
         below. Off by default: the radar above needs no data connection at
         all and stays the safety default, while this is an opt-in extra for
         when an area's tiles have been downloaded ahead of time. -->
    <org.osmdroid.views.MapView
        android:id="@+id/offlineMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/navigationHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/color_on_accent"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="↑ Straight ahead · 340 m" />

    <!-- How much to trust the "you are here" dot — color escalates the same
         way the header's daylight pill does, since a wide accuracy radius
         silently misplacing someone by 50-100m is exactly the kind of thing
         that should be visible, not hidden behind a dot that looks just as
         confident whether it's accurate to 5m or 200m. (The daylight pill
         itself moved into the app's top bar — visible on every tab now,
         not just this one — so this takes the spot it used to sit in,
         leaving the radar underneath it uncovered.) -->
    <TextView
        android:id="@+id/accuracyPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/color_on_accent"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="±18 m" />

    <TextView
        android:id="@+id/mapEmptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_peers"
        android:textColor="@color/sand_300" />

    <!-- Smaller and in a 2x2 grid now instead of a tall single column of
         full-size buttons — "make them more small", and a grid leaves more
         of the radar itself visible above/beside it rather than a column
         running most of the way up one edge. -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:columnCount="2"
        android:rowCount="3">

        <Button
            android:id="@+id/qiblaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:text="@string/qibla_button" />

        <Button
            android:id="@+id/myPlacesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:text="@string/my_places" />

        <Button
            android:id="@+id/savePlaceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:text="@string/save_this_spot" />

        <Button
            android:id="@+id/enterCoordinatesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:text="@string/enter_coordinates_button" />

        <!-- Switches between the always-available offline radar and a real
             map view (OpenStreetMap). Highlights the same way qiblaButton
             does while map mode is on. -->
        <Button
            android:id="@+id/mapToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:text="@string/map_toggle_button" />

        <!-- Only shown while map mode is on — downloads the tiles for the
             area currently on screen so it keeps working with no connection
             afterward. -->
        <Button
            android:id="@+id/downloadAreaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/color_on_accent"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="@string/download_area_button" />

    </GridLayout>

    <!-- Re-center on "me" — the one thing missing once pan/zoom exist at
         all: after dragging the map around to look at something far off,
         there was no quick way back to center except pinching/dragging
         back by feel. Small, out of the way, top-end corner. -->
    <Button
        android:id="@+id/recenterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:background="@drawable/bg_button_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/color_on_accent"
        android:textSize="14sp"
        android:contentDescription="@string/recenter_map"
        android:text="⊙" />

</FrameLayout>
