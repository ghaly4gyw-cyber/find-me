<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ghaly.findme.ui.RadarMapView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/navigationHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/sand_900"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="↑ Straight ahead · 340 m" />

    <TextView
        android:id="@+id/daylightPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/sand_900"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="☼ 2h 14m left" />

    <!-- How much to trust the "you are here" dot — color escalates the same
         way the daylight pill does, since a wide accuracy radius silently
         misplacing someone by 50-100m is exactly the kind of thing that
         should be visible, not hidden behind a dot that looks just as
         confident whether it's accurate to 5m or 200m. -->
    <TextView
        android:id="@+id/accuracyPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_button_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/sand_900"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="±18 m" />

    <TextView
        android:id="@+id/mapEmptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_peers"
        android:textColor="@color/sand_300" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/qiblaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/sand_900"
            android:text="@string/qibla_button" />

        <Button
            android:id="@+id/myPlacesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/sand_900"
            android:text="@string/my_places" />

        <Button
            android:id="@+id/savePlaceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/sand_900"
            android:text="@string/save_this_spot" />

        <Button
            android:id="@+id/enterCoordinatesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/sand_900"
            android:text="@string/enter_coordinates_button" />

    </LinearLayout>

</FrameLayout>
