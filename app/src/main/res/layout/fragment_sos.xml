<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/sosButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/sos_button"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_sos"
        android:stateListAnimator="@animator/press_scale" />

    <TextView
        android:id="@+id/sosHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/sand_300"
        android:gravity="center"
        android:text="@string/no_peers" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sosList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inactiveList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

</LinearLayout>
