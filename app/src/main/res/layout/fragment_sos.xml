<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/sosButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/sos_button"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_sos"
        android:stateListAnimator="@animator/press_scale" />

    <TextView
        android:id="@+id/sosHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/sand_300"
        android:gravity="center"
        android:text="@string/no_peers" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sosList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sand_300"
            android:textSize="13sp"
            android:text="@string/physical_signal_hint" />

        <Button
            android:id="@+id/physicalSignalButton"
            style="@style/FindMe.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/physical_signal_start" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/smsBridgeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sand_300"
            android:textSize="13sp"
            android:text="@string/sms_bridge_no_contact" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/smsBridgeSetContact"
                style="@style/FindMe.Button.Pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/sms_bridge_set_contact" />

            <Button
                android:id="@+id/smsBridgeSendNow"
                style="@style/FindMe.Button.Pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sms_bridge_send_now" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inactiveList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

</LinearLayout>
