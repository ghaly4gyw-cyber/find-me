<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the downloaded update APK, written to the app's own cache dir
     (see UpdateChecker.downloadApk). -->
<paths>
    <cache-path name="updates" path="." />
    <!-- Covers CrashLog/AnrWatchdog/AppLog's files, all written to the
         app's own filesDir, so the debug log can be shared the same way. -->
    <files-path name="diagnostics" path="." />
</paths>
